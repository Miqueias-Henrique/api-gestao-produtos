              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha atualizada com sucesso"
          },
          "400": {
            "description": "ID ou senha inválidos"
          },
          "403": {
            "description": "Sem permissão para alterar a senha deste usuário"
          },
          "404": {
            "description": "Usuário não encontrado"
          }
        }
      }
    },

{
  "openapi": "3.0.0",
  "info": {
    "title": "API WEB II",
    "version": "1.0.0",
    "description": "Documentação da API completa para todos os 5 recursos"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "pageParam": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "description": "Número da página"
      },
      "limitParam": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "description": "Quantidade de registros por página"
      },
      "idParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "ID do recurso"
      }
    },
    "schemas": {
      "PaginatedResult": {
        "type": "object",
        "required": [
          "data",
          "total",
          "page",
          "limit",
          "lastPage"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "lastPage": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/test-connection": {
      "get": {
        "tags": [
          "Health"
        ],
        "security": [],
        "summary": "Testa a conexão com a API",
        "responses": {
          "200": {
            "description": "Conexão realizada com sucesso"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Autentica o usuário e retorna um token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "E-mail ou senha inválidos"
          },
          "403": {
            "description": "Usuário inativo ou pendente"
          }
        }
      }
    },
    "/validate-token": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Valida o token JWT atual",
        "responses": {
          "200": {
            "description": "Token válido"
          },
          "401": {
            "description": "Token inválido ou expirado"
          }
        }
      }
    },
    "/recover-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Envia e-mail com link para recuperação de senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "urlRecoverPassword": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "email",
                  "urlRecoverPassword"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Instruções enviadas"
          },
          "400": {
            "description": "Dados inválidos"
          }
        }
      }
    },
    "/validate-recover-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Valida a chave de recuperação de senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "recoverPassword": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "recoverPassword"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chave válida"
          },
          "400": {
            "description": "Dados inválidos ou chave expirada"
          },
          "404": {
            "description": "Chave inválida ou já utilizada"
          }
        }
      }
    },
    "/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "summary": "Redefine a senha utilizando a chave de recuperação",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "key": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                },
                "required": [
                  "email",
                  "key",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada com sucesso"
          },
          "400": {
            "description": "Dados inválidos ou link inválido/expirado"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Lista todos os usuários",
